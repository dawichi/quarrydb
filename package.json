{
  "name": "quarrydb",
  "version": "0.1.3",
  "private": true,
  "workspaces": [
    "packages/*",
    "landing"
  ],
  "scripts": {
    "ng": "ng",
    "tw:dev": "tailwindcss -i src/tailwind-input.css -o src/styles.css --watch",
    "tw:build": "tailwindcss -i src/tailwind-input.css -o src/styles.css --minify",
    "start": "concurrently -n TW,NG -c cyan,green \"bun run tw:dev\" \"ng serve\"",
    "build": "bun run tw:build && ng build",
    "tauri": "tauri",
    "lint": "biome lint src/ packages/",
    "format": "biome format --write src/ packages/",
    "check": "biome check --write src/ packages/",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@angular/common": "^20.1.4",
    "@angular/compiler": "^20.1.4",
    "@angular/core": "^20.1.4",
    "@angular/forms": "^20.1.4",
    "@angular/platform-browser": "^20.1.4",
    "@angular/router": "^20.1.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-sql": "^2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.1.4",
    "@angular/cli": "^20.1.4",
    "@angular/compiler-cli": "^20.1.4",
    "@biomejs/biome": "^2",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/cli": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "concurrently": "^10.0.3",
    "tailwindcss": "^4",
    "typescript": "~5.8.3",
    "vitest": "^4.1.8"
  }
}