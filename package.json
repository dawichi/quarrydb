{
  "name": "quarrydb",
  "version": "0.1.9",
  "private": true,
  "packageManager": "bun@1.3.4",
  "workspaces": [
    "packages/*",
    "landing"
  ],
  "scripts": {
    "ng": "ng",
    "tw:dev": "tailwindcss -i src/tailwind-input.css -o src/styles.css --watch",
    "tw:build": "tailwindcss -i src/tailwind-input.css -o src/styles.css --minify",
    "start": "concurrently -n TW,NG -c cyan,green \"bun run tw:dev\" \"ng serve\"",
    "start:e2e": "bun run tw:build && ng serve --host 127.0.0.1 --port 1420",
    "build": "bun run tw:build && ng build",
    "tauri": "tauri",
    "dev:services:up": "bash scripts/dev-services-up.sh",
    "dev:services:down": "docker compose -f docker-compose.local-test-services.yml down",
    "dev:services:logs": "docker compose -f docker-compose.local-test-services.yml logs -f",
    "test:mysql": "bash scripts/test-mysql.sh",
    "test:redis": "bash scripts/test-redis.sh",
    "audit:rust": "cd src-tauri && cargo audit --deny unsound --ignore RUSTSEC-2026-0194 --ignore RUSTSEC-2026-0195 --ignore RUSTSEC-2026-0235 --ignore RUSTSEC-2023-0071 --ignore RUSTSEC-2026-0190 --ignore RUSTSEC-2026-0221 --ignore RUSTSEC-2024-0429",
    "audit:dependencies": "bun audit --audit-level=critical && bun pm untrusted && bun run audit:rust",
    "lint": "biome lint src/ packages/",
    "format": "biome format --write src/ packages/",
    "check": "biome check --write src/ packages/",
    "check:ci": "biome check src/ packages/",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "build:landing": "bun run --cwd landing build",
    "qa": "bun run check:ci && bun run test:run && bun run test:e2e && bun run build && bun run build:landing"
  },
  "dependencies": {
    "@angular/common": "^20.3.28",
    "@angular/compiler": "^20.3.28",
    "@angular/core": "^20.3.28",
    "@angular/forms": "^20.3.28",
    "@angular/platform-browser": "^20.3.28",
    "@angular/router": "^20.3.28",
    "@lucide/angular": "^1.31.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^20.3.34",
    "@angular/cli": "^20.3.34",
    "@angular/compiler-cli": "^20.3.28",
    "@biomejs/biome": "^2.5.8",
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/cli": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "concurrently": "^10.0.5",
    "mysql2": "^3.23.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "hono": "4.12.25",
    "immutable": "5.1.8",
    "ip-address": "10.3.1",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "svgo": "4.0.2",
    "sharp": "0.35.3",
    "tar": "7.5.22",
    "undici": "6.27.0",
    "vite": "7.3.6"
  }
}
