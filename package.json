{
  "name": "quarrydb",
  "version": "0.2.1",
  "private": true,
  "packageManager": "bun@1.3.4",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "workspaces": [
    "packages/*",
    "landing"
  ],
  "scripts": {
    "ng": "ng",
    "tw:dev": "tailwindcss -i src/tailwind-input.css -o src/styles.css --watch",
    "tw:build": "tailwindcss -i src/tailwind-input.css -o src/styles.css --minify",
    "start": "concurrently -n TW,NG -c cyan,green \"bun run tw:dev\" \"ng serve\"",
    "start:e2e": "bun run tw:build && ng serve --host 127.0.0.1 --port 1420",
    "build": "bun run tw:build && ng build",
    "tauri": "tauri",
    "dev:services:up": "bash scripts/dev-services-up.sh",
    "dev:services:down": "docker compose -f docker-compose.local-test-services.yml down",
    "dev:services:logs": "docker compose -f docker-compose.local-test-services.yml logs -f",
    "test:mysql": "bash scripts/test-mysql.sh",
    "test:redis": "bash scripts/test-redis.sh",
    "audit:rust": "cd src-tauri && cargo audit",
    "audit:dependencies": "bun audit --audit-level=critical && bun pm untrusted && bun run audit:rust",
    "check:docs": "bun scripts/check-doc-links.ts",
    "lint": "biome lint src/ packages/",
    "format": "biome format --write src/ packages/",
    "check": "biome check --write src/ packages/",
    "check:ci": "biome check src/ packages/",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:landing": "playwright test --config=playwright.landing.config.ts",
    "build:landing": "bun run --cwd landing build",
    "qa": "bun run check:ci && bun run check:docs && bun run test:run && bun run test:e2e && bun run test:landing && bun run build && bun run build:landing"
  },
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@lucide/angular": "^1.59.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/cli": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "concurrently": "^10.0.6",
    "mysql2": "^3.24.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@jridgewell/sourcemap-codec": "1.6.0",
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "hono": "4.12.25",
    "immutable": "5.1.8",
    "ip-address": "10.3.1",
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "svgo": "4.0.2",
    "sharp": "0.35.3",
    "tar": "7.5.22",
    "undici": "6.27.0",
    "vite": "8.3.0"
  }
}
