<!-- ─── Interactive demo script ────────────────────────────────────────────── -->
<script>
const ORDERS = [
    { id: 1,  customer_id: 1,  status: 'delivered', total: 1389.98, created_at: '2024-03-01' },
    { id: 2,  customer_id: 1,  status: 'shipped',   total: 179.98,  created_at: '2024-05-10' },
    { id: 3,  customer_id: 2,  status: 'delivered', total: 84.98,   created_at: '2024-03-15' },
    { id: 4,  customer_id: 2,  status: 'cancelled', total: 499.99,  created_at: '2024-04-20' },
    { id: 5,  customer_id: 3,  status: 'delivered', total: 89.98,   created_at: '2024-04-05' },
    { id: 6,  customer_id: 4,  status: 'delivered', total: 239.97,  created_at: '2024-04-18' },
    { id: 7,  customer_id: 5,  status: 'shipped',   total: 329.98,  created_at: '2024-05-02' },
    { id: 8,  customer_id: 5,  status: 'pending',   total: 44.99,   created_at: '2024-06-01' },
    { id: 9,  customer_id: 6,  status: 'delivered', total: 139.98,  created_at: '2024-05-20' },
    { id: 10, customer_id: 7,  status: 'delivered', total: 149.99,  created_at: '2024-04-30' },
    { id: 11, customer_id: 8,  status: 'shipped',   total: 549.98,  created_at: '2024-05-25' },
    { id: 12, customer_id: 8,  status: 'pending',   total: 79.99,   created_at: '2024-06-05' },
    { id: 13, customer_id: 9,  status: 'delivered', total: 239.97,  created_at: '2024-05-08' },
    { id: 14, customer_id: 10, status: 'delivered', total: 119.98,  created_at: '2024-05-15' },
    { id: 15, customer_id: 3,  status: 'pending',   total: 499.99,  created_at: '2024-06-08' },
]

/** @type {{ type: 'where' | 'orderby' }[]} */
let steps = []

function compute() {
    let rows = [...ORDERS]
    const cteParts = []
    let stepIndex = 0

    if (steps.find(s => s.type === 'where')) {
        stepIndex++
        rows = rows.filter(r => r.status === 'delivered')
        cteParts.push(`step_${stepIndex} AS (\n  SELECT * FROM ${stepIndex === 1 ? 'orders' : `step_${stepIndex - 1}`}\n  WHERE status = 'delivered'\n)`)
    }
    if (steps.find(s => s.type === 'orderby')) {
        stepIndex++
        rows = [...rows].sort((a, b) => b.total - a.total)
        cteParts.push(`step_${stepIndex} AS (\n  SELECT * FROM ${stepIndex === 1 ? 'orders' : `step_${stepIndex - 1}`}\n  ORDER BY total DESC\n)`)
    }

    const sql = cteParts.length
        ? `WITH ${cteParts.join(',\n     ')}\nSELECT * FROM step_${stepIndex}`
        : 'SELECT * FROM orders'

    return { rows, sql }
}

function renderStepCard(type, index) {
    const label = type === 'where' ? 'WHERE' : 'ORDER BY'
    const expr = type === 'where' ? "status = 'delivered'" : 'total DESC'
    return `
        <div class="flex justify-center py-1"><div class="w-px h-4 bg-zinc-700"></div></div>
        <div class="rounded-lg border border-zinc-700 bg-zinc-900 overflow-hidden text-xs">
            <div class="flex items-center gap-2 px-3 py-2 border-b border-zinc-800 bg-zinc-800/40">
                <span class="font-mono font-bold text-sky-400">${label}</span>
                <button
                    data-remove="${index}"
                    class="ml-auto text-zinc-600 hover:text-red-400 transition-colors leading-none"
                    title="Remove step"
                >✕</button>
            </div>
            <div class="px-3 py-2 font-mono text-zinc-300">${expr}</div>
        </div>`
}

function render() {
    const { rows, sql } = compute()

    // Steps
    const stepsEl = document.getElementById('demo-steps')
    stepsEl.innerHTML = steps.map((s, i) => renderStepCard(s.type, i)).join('')

    // Remove buttons
    stepsEl.querySelectorAll('[data-remove]').forEach(btn => {
        btn.addEventListener('click', (e) => {
            e.stopPropagation()
            const i = Number(btn.getAttribute('data-remove'))
            steps.splice(i, 1)
            render()
        })
    })

    // SQL
    document.getElementById('demo-sql').textContent = sql

    // Row count
    document.getElementById('demo-row-count').textContent = `${rows.length} row${rows.length !== 1 ? 's' : ''}`

    // Table body
    const tbody = document.getElementById('demo-table-body')
    tbody.innerHTML = rows.slice(0, 10).map((r, i) => `
        <tr class="border-b border-zinc-800/50 hover:bg-zinc-800/30 transition-colors ${i % 2 === 0 ? '' : 'bg-zinc-900/20'}">
            <td class="px-3 py-2 text-zinc-400">${r.id}</td>
            <td class="px-3 py-2 text-zinc-400">${r.customer_id}</td>
            <td class="px-3 py-2">
                <span class="px-1.5 py-0.5 rounded text-xs ${
                    r.status === 'delivered' ? 'bg-green-900/40 text-green-400' :
                    r.status === 'shipped'   ? 'bg-sky-900/40 text-sky-400' :
                    r.status === 'pending'   ? 'bg-yellow-900/40 text-yellow-400' :
                                               'bg-red-900/40 text-red-400'
                }">${r.status}</span>
            </td>
            <td class="px-3 py-2 text-zinc-300 font-mono">$${r.total.toFixed(2)}</td>
            <td class="px-3 py-2 text-zinc-500">${r.created_at}</td>
        </tr>`).join('')

    // Add buttons / reset visibility
    const hasWhere   = steps.some(s => s.type === 'where')
    const hasOrderBy = steps.some(s => s.type === 'orderby')
    const btnWhere   = document.getElementById('btn-add-where')
    const btnOrderBy = document.getElementById('btn-add-orderby')
    const btnReset   = document.getElementById('btn-reset')

    btnWhere.classList.toggle('hidden', hasWhere)
    btnOrderBy.classList.toggle('hidden', hasOrderBy)
    btnReset.classList.toggle('hidden', steps.length === 0)

    const addButtons = document.getElementById('demo-add-buttons')
    addButtons.classList.toggle('hidden', hasWhere && hasOrderBy)
}

document.getElementById('btn-add-where').addEventListener('click', () => {
    steps.push({ type: 'where' })
    render()
})
document.getElementById('btn-add-orderby').addEventListener('click', () => {
    steps.push({ type: 'orderby' })
    render()
})
document.getElementById('btn-reset').addEventListener('click', () => {
    steps = []
    render()
})

render()
</script>
