{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quarry",
  "version": "0.1.9",
  "identifier": "dev.quarrydb.app",
  "build": {
    "beforeDevCommand": "bun run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist/quarrydb/browser"
  },
  "app": {
    "windows": [
      {
        "title": "Quarry",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: https://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBNTgwNzZEQTUxNkU1RTYKUldUbTVSYWxiUWRZR29uSUs4MG5Kb3BQd1ZiZS9WYWE2aWJ1a2c5UmhmTFRQMzkvRE5Nb2l0d2UK",
      "endpoints": [
        "https://github.com/dawichi/quarrydb/releases/latest/download/latest.json"
      ]
    }
  }
}
